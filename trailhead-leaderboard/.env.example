# From strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Must exactly match a "Authorization Callback Domain" on your Strava app,
# and use the https://<your-domain>/api/auth/callback path
STRAVA_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback

# Any random string — sent as a header by Vercel Cron, checked by /api/cron/poll
CRON_SECRET=change-me-to-something-random

# Competition window (ISO 8601). Activities before this are ignored.
COMPETITION_START=2026-09-01T00:00:00Z

# Estimated stride constant used to derive steps from distance
STEPS_PER_KM=1330

# Auto-populated by Vercel when you add the Postgres integration —
# you normally don't set this by hand.
POSTGRES_URL=
